# https://jorisroovers.com/gitlint/rules/

[general]
ignore=body-is-missing,body-min-length
regex-style-search=True

[title-max-length]
line-length=80

[title-min-length]
min-length=5

[title-must-not-contain-word]
words=wip

[ignore-by-body]
regex=(.*)```(.*)
ignore=body-max-line-length

[ignore-body-lines]
regex=^http(s)?://

[title-match-regex]
regex=^[A-Z]+.*(?!=\.)

[body-max-line-length]
line-length=80
