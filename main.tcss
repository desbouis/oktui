/* --- Layout de base --- */
#sidebar {
    width: 20%;
    background: $panel;
    padding: 1 1;
    border-right: tall $primary;
    text-style: bold;
}
#sidebar:hover {
    background: $primary 20%;
}
#sidebar:light {
    background: #e8e8f0;
    color: #333333;
}

#instances-list-title {
    margin: 0 0 1 1
}

TabbedContent #--content-tab-tab-server-show,
TabbedContent #--content-tab-tab-console-log-show,
TabbedContent #--content-tab-tab-server-event-list
{
    background: $surface;
    margin: 0 1 0 0;
}

#main-tabbed-content {
    width: 1fr;
    height: 100%;
    margin: 1 0 0 0;
}

#content-server-show,
#content-console-log-show,
#content-server-event-list
{
    width: 1fr;
    background: $surface;
    border: solid $primary;
    border-title-color: $primary;
    border-title-style: bold;
    padding: 1;
    margin: 0 0 0 0;
}

#status-bar-set {
    height: 1;
    background: $primary;
    color: $text;
    padding: 0 2;
}

#status-bar-message {
    width: 90%;
}

#status-bar-release {
    width: 10%;
    text-align: right;
}

#instances-list {
    height: 1fr;
}

Input {
    margin: 0 0 1 0;
}
